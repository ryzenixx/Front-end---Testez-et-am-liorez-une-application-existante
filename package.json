{
  "name": "etudiant-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "build:e2e": "ng build --configuration development --output-path dist/e2e && node cypress/instrument.cjs",
    "serve:e2e": "serve --single --listen tcp://127.0.0.1:4300 dist/e2e/browser",
    "e2e:run": "cypress run",
    "e2e": "npm run build:e2e && start-server-and-test serve:e2e http-get://127.0.0.1:4300 e2e:run"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.7",
    "@angular/cli": "^19.2.16",
    "@angular/compiler-cli": "^19.2.0",
    "@cypress/code-coverage": "^4.1.3",
    "@types/jest": "^29.5.4",
    "cypress": "^16.2.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.5.1",
    "serve": "^14.2.8",
    "start-server-and-test": "^3.0.13",
    "typescript": "~5.7.2"
  }
}
